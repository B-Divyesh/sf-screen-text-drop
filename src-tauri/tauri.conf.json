{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Text Drop",
  "version": "0.1.1",
  "identifier": "in.sociobot.screen-text-drop",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Screen Text Drop",
      "width": 1100,
      "height": 760,
      "minWidth": 720,
      "minHeight": 600,
      "center": true,
      "visible": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' https://api.sociobot.in"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Turn a screen region into clean local text",
    "longDescription": "Private offline OCR for screen regions, with paragraph, code, table, and Markdown cleanup.",
    "copyright": "Copyright © 2026 Sociobot",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
